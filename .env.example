# 默认兼容 01.py–17.py 的 Anthropic 配置。不要提交真实密钥。
EDACODE_PROVIDER=anthropic
ANTHROPIC_API_KEY=replace-me
# ANTHROPIC_BASE_URL=https://your-compatible-endpoint
MODEL_ID=your-model-id

# 使用 OpenAI Chat Completions 兼容接口时，安装 .[openai] 并改用：
# EDACODE_PROVIDER=openai
# OPENAI_API_KEY=replace-me
# OPENAI_BASE_URL=https://your-endpoint/v1
# EDACODE_MODEL=your-model-id

# EDACODE_MODE=edit
# EDACODE_MAX_TURNS=40
# EDACODE_CONTEXT_CHARS=120000
# EDACODE_HOME=~/.edacode
